# Server-only. Load with Node 22+: node --env-file=.env.local server/http.mjs
PORT=4174
# Persist this directory on a shared display gateway; do not commit runtime data.
DISPLAY_CACHE_DIR=.cache/display
# Optional: existing StarKid /api/sky-events endpoint. Public responses only.
# DISPLAY_SKY_EVENTS_URL=https://YOUR-STARKID-HOST/api/sky-events?type=upcoming&category=sky_event&days=60&limit=20
# Unset: reuse the repository's approximate recurring sky calendar, clearly labeled.
